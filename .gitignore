yarn-debug.log*
yarn-error.log*

# Local backup folder
copy/

# Authentication and session cookies
*cookies*.txt
server/cookies.txt
# Kaggle API credentials (username + key) - JANGAN PERNAH commit, dan revoke bila
# pernah tersentuh folder yang di-share. Lihat kaggle/vlm_oracle_qwen.py.
kaggle.json
.kaggle/
# Hasil staging kaggle/deploy.ps1: berisi metadata dengan username Kaggle asli,
# dan oracle_config.json yang memuat URL tunnel + API_ACCESS_TOKEN.
kaggle/.deploy/
kaggle/.deploy-config/

# AI Gatekeeper Model weights & test cache
server/gatekeeper/models/*.onnx
server/gatekeeper/models/*.tflite
server/gatekeeper/models/*.data
# Bobot VLM lokal (SmolVLM2 GGUF + projector) - diunduh sekali di PC, push ke Termux via scp.
server/gatekeeper/models/*.gguf
server/gatekeeper/models/*mmproj*.gguf
server/gatekeeper/test_temp/
server/gatekeeper/dataset/*
!server/gatekeeper/dataset/*.json
*.zip
__pycache__/
*.pyc
scratch/
*.bak

# Salinan .env yang diambil dari Termux (berisi API key)
.env-from-termux/

# Catatan lokal pribadi (tidak dilacak ke repo)
syarat proxy sock5.txt
