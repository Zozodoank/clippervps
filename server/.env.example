# Local AI Affiliate Clipper Backend Configuration
PORT=5000

# OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Opsional: Tentukan model OpenRouter utama (Hanya gunakan model :free agar saldo tidak terpotong)
# Contoh gratis 100%: openrouter/free, google/gemini-2.0-flash-exp:free, meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_MODEL=openrouter/free

# Active AI Engine (Pilihan: gemini atau openrouter)
# gemini = Pola Gemini File API + Gemini (DEFAULT: native stream/file + Gemini Direct)
# openrouter = Pola FFmpeg + OpenRouter (Manual: ekstraksi frame FFmpeg + OpenRouter free)
ACTIVE_AI_ENGINE=gemini

# Google Gemini API (https://aistudio.google.com/)
# Digunakan untuk Pola Gemini File API + Gemini Direct (Analisa video + naskah/caption/hashtag)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional yt-dlp auth fallback for YouTube 429 / "not a bot" checks.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=./cookies.txt

# Optional downloader fallbacks.
# LOW_DATA_MODE=false (Default: selalu unduh langsung 1080p Full HD murni dari YouTube)
# COBALT_API_URL=
# COBALT_API_KEY=your_cobalt_api_key_here

# TTS Voiceover Settings (Default: Google Gemini Flash TTS Free Tier: 10 RPD)
TTS_PROVIDER=gemini_tts
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FALLBACK_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Despina
# Alternatif: Microsoft Edge TTS (100% Free & Unlimited)
TTS_VOICE=id-ID-GadisNeural

# VPS Server SSH Configuration
VPS_HOST=208.76.40.194
VPS_PORT=14115
VPS_USER=ubuntu
VPS_PASSWORD=your_vps_password_here

# Cloudflare Tunnel Public HTTPS URL
CLOUDFLARE_TUNNEL_URL=https://your-tunnel.trycloudflare.com

# Optional API Access Token Authentication (Direkomendasikan untuk Cloudflare Tunnel)
# Jika dikosongkan (default), server terbuka bebas untuk pemakaian lokal.
# Jika diisi, request ke endpoint sensitif wajib menyertakan token via header 'x-api-token' atau query '?api_token='.
API_ACCESS_TOKEN=

# Batas kuota produksi video harian (default: 20 video per hari untuk menjaga IP dari pemblokiran)
DAILY_VIDEO_LIMIT=20

