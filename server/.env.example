# Local AI Affiliate Clipper Backend Configuration
PORT=5000

# OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Opsional: Tentukan model OpenRouter utama (Hanya gunakan model :free agar saldo tidak terpotong)
# Contoh gratis 100%: openrouter/free, google/gemini-2.0-flash-exp:free, meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_MODEL=openrouter/free

# Active AI Engine (Pilihan: gemini atau openrouter)
# gemini = Pola Gemini File API + Gemini (DEFAULT: native stream/file + Gemini Direct)
# openrouter = Pola FFmpeg + OpenRouter (Manual: ekstraksi frame FFmpeg + OpenRouter free)
ACTIVE_AI_ENGINE=gemini

# Google Gemini API (https://aistudio.google.com/)
# Digunakan untuk Pola Gemini File API + Gemini Direct (Analisa video + naskah/caption/hashtag)
GEMINI_API_KEY=your_gemini_api_key_here

# ── GEMINI INPUT MODE (Evidence Mode — hemat token Gemini & 0 MB kuota internet) ──
# evidence = DEFAULT (disarankan): Gemini hanya menilai FRAME BERSIH hasil Gatekeeper
#            lokal yang sudah ada di disk (bukti). Video penuh TIDAK dibaca ulang via
#            fileUri/File API => token Gemini per job turun drastis, kuota internet
#            NOL tambahan (frame sudah terdownload saat sampling). Stream/File API
#            tetap jadi fallback otomatis bila frame bukti kurang dari EVIDENCE_MIN_FRAMES.
# stream   = perilaku lama: Gemini menganalisa video YouTube penuh via fileUri.
# GEMINI_INPUT_MODE=evidence
# EVIDENCE_MIN_FRAMES=6 : minimal frame bersih agar jalur evidence dipakai (di bawah ini -> stream).
# EVIDENCE_MAX_FRAMES=30: batas atas keyframe bukti yang dikirim ke Gemini.
# EVIDENCE_MIN_FRAMES_PER_SOURCE=2: jatah MINIMAL keyframe per VIDEO SUMBER di dalam
#   bukti tadi. Mencegah Reels 1 sumber: walau satu video menyumbang 100 frame bersih
#   dan video lain cuma 5, tiap sumber tetap ikut terkirim ke Gemini (lalu di-interleave).
# Catatan: mode ini dibekukan per-job (configSnapshot) sehingga retry memakai mode yang sama.

# ---------------------------------------------------------------------------
# TUNNEL PUBLIK (dibaca start-tunnel.sh / menu-vps.sh nomor 5-6) - hanya perlu untuk Oracle
# Kaggle. Arah panggilnya TERBALIK: notebook-lah yang mengetuk /api/vlm-oracle/* kita, jadi
# perangkat yang menjalankan server wajib punya URL publik.
#   NGROK_URL / NGROK_DOMAIN : isi bila memakai ngrok plan gratis (dev domain tidak berubah).
#                    NGROK_URL menerima bentuk penuh, NGROK_DOMAIN cukup host-nya saja:
#                      NGROK_URL=https://abc1234.ngrok-free.dev
#                      NGROK_DOMAIN=abc1234.ngrok-free.dev
#                    NGROK_URL menang. Sufiks TIDAK divalidasi - domain gratis jaman sekarang
#                    bisa .ngrok-free.dev maupun .ngrok-free.app.
#                    Authtoken ngrok TIDAK ditaruh di sini - simpan di config agent ngrok
#                    (`ngrok config add-authtoken ...`), lihat ngrok.md.
#   TUNNEL_PORT    : port API yang dit-forward. Default 5000.
#   CLOUDFLARE_TUNNEL_URL : URL aktif hasil start-tunnel.sh. Nama key-nya dipertahankan walau
#                    isinya bisa URL ngrok, karena kaggle/deploy.ps1 -FromTermux membaca key ini.
# CATATAN URUTAN: root .env (satu level di atas berkas ini) dimuat TERAKHIR oleh
# utils/envLoader.js dan karena itu MENIMPA nilai di sini untuk key yang sama. Taruh URL
# tunnel di satu tempat saja - ngrok.md bagian 7.
# NGROK_URL=
# TUNNEL_PORT=5000

# Optional yt-dlp auth fallback for YouTube 429 / "not a bot" checks.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=./cookies.txt

# Optional downloader fallbacks.
# LOW_DATA_MODE=false (Default: selalu unduh langsung 1080p Full HD murni dari YouTube)
# COBALT_API_URL=
# COBALT_API_KEY=your_cobalt_api_key_here

# ── HEMAT KUOTA: unduhan tahap RENDER (final 1080p) ──
# Sampling/analisa tetap 480p hemat; penghematan ini hanya affects download video final untuk dipotong.
# RENDER_MAX_HEIGHT: batasi tinggi video yang diunduh untuk render. Default 1080 di SEMUA mesin (PC maupun Termux) -> hasil akhir dipaksa 1080p pada semua mode & retry (nilai ini ikut dibekukan di configSnapshot). Turunkan ke 720 hanya bila bersedia render lebih lambat/panas di Termux.
#   Catatan kualitas: sampling/verifikasi tetap murah (360p utk jalur SmolVLM2, 480p utk stride lama) - TIDAK terpengaruh flag ini. Untuk menjamin sumber asli >720p, gerbang metadata menuntut cookies.txt agar probe format terpercaya.
# RENDER_VIDEO_ONLY: default ON (kosong/1) => audio sumber TIDAK diunduh (render tetap `-an` / tanpa suara).
#   OTOMATIS TEMBUS (audio diunduh) bila AUDIO_DRIVEN_SCENES=true, karena whisper.cpp wajib punya track audio
#   sumber untuk mengekstrak beat. Set 0 bila ingin paksa unduh audio walau audio-driven mati.
#   Nilai flag ini ikut DIBEKUKAN di configSnapshot job (bersama AUDIO_DRIVEN_SCENES) saat retry.
# RENDER_MAX_HEIGHT=1080
# RENDER_VIDEO_ONLY=1

# ── DURASI KANDIDAT YOUTUBE (gerbang pencarian + metadata) ──
# AUTO MODE menolak video terlalu pendek. Shorts (< 5 mnt) terbukti sedikit frame,
# sumber ~270p, dan memicu adegan berulang -> buruk untuk algoritma Reels.
# MIN_VIDEO_DURATION_SEC: detik minimal. DEFAULT 300 (5 menit). Set 0 = matikan gerbang minimal.
# MAX_VIDEO_DURATION_SEC: detik maksimal. DEFAULT 900 (15 menit).
# Catatan: mode MANUAL/OEM melewati gerbang ini, jadi URL pendek pilihan Anda tetap bisa dipakai.
# MIN_VIDEO_DURATION_SEC=300
# MAX_VIDEO_DURATION_SEC=900
# DOWNLOAD_ARCHIVE_PATH: ANTI unduh ulang lintas job. DEFAULT OFF (kosongkan = aman).
#   PENTING: aktifkan HANYA jika folder output render bersifat PERSISTEN (tidak dibersihkan antar job),
#   karena yt-dlp akan MELEWATI unduhan videoId yang sudah tercatat sehingga file tidak diunduh ulang.
#   Contoh: DOWNLOAD_ARCHIVE_PATH=./render_download_archive.txt
# DOWNLOAD_ARCHIVE_PATH=
#
# RENDER_DOWNLOAD_SECTIONS: #1 UNDUH HANYA SEGMEN yang dipakai (potensial hemat 80-95%). DEFAULT OFF ('0'/kosong
#   = unduh penuh, perilaku lama). Set 1 untuk aktifkan. Risiko: lebih banyak request yt-dlp (potensi 403 di
#   Termux naik). Berlaku di KEDUA jalur render: AUTO multi-kandidat DAN MANUAL/single-video. Tanpa
#   RENDER_NO_FULL_DOWNLOAD, satu segmen gagal -> fallback ke unduhan penuh untuk kandidat itu.
# RENDER_DOWNLOAD_SECTIONS=1
# RENDER_NO_FULL_DOWNLOAD: DEFAULT OFF. Set 1 (HANYA berarti bersama RENDER_DOWNLOAD_SECTIONS=1) => mode
#   TEGAS: segmen gagal = klip dibuang, TIDAK PERNAH fallback unduh penuh; semua segmen gagal -> job gagal jelas.
# RENDER_NO_FULL_DOWNLOAD=1
#   Tunjangan clustering (opsional, hanya dipakai saat RENDER_DOWNLOAD_SECTIONS=1):
# RENDER_SECTION_PAD=2        # detik sebelum klip pertama tiap cluster (akurasi seek/keyframe)
# RENDER_SECTION_TAIL_PAD=5   # detik setelah klip terakhir (menyerap perpanjangan durasi pacing/conform)
# RENDER_SECTION_GAP=15       # celah maksimum antar-klip agar digabung jadi satu unduhan
#
# ── HEMAT SEEK: penyelarasan sampling analisa ↔ budget Gatekeeper ──
# GK_ALIGN_SAMPLING: DEFAULT OFF (set 1 untuk aktifkan). Pangkas JUMLAH SEEK FFmpeg di
#   sampleFramesFromStream agar sama persis dengan jumlah frame yang benar-benar diproses
#   Gatekeeper (frame di atas batchCap tidak pernah dibaca downstream). Hemat ~50% spawn
#   FFmpeg + range-request per kandidat; output Gatekeeper tetap identik.
#   Basisnya GK_MAX_BATCH_FRAMES (default 240) - bila ubah nilai itu, budget ikut menyesuaikan.
# GK_ALIGN_SAMPLING=1

# TTS Voiceover Settings (Default: Google Gemini Flash TTS Free Tier: 10 RPD)
TTS_PROVIDER=gemini_tts
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FALLBACK_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Despina

# Optional API Access Token Authentication
# Jika dikosongkan (default), server terbuka bebas untuk pemakaian lokal.
# Jika diisi, SEMUA endpoint /api (kecuali allowlist: /health, /daily-limit, /niches,
# /video, /audio, /download, /rejected-frames) mewajibkan token via header 'x-api-token',
# 'Authorization: Bearer <token>', atau query '?api_token=' (dipakai EventSource).
# PENTING: jangan mengandalkan pengecualian localhost - cloudflared meneruskan pengunjung
# publik ke 127.0.0.1, jadi hanya token yang bisa membedakan pemanggil sah.
# Setelah token diisi, skrip pemanggil non-browser di scratch/ otomatis ikut mengirimnya
# (mereka membaca API_ACCESS_TOKEN dari file ini).
API_ACCESS_TOKEN=

# Origin CORS tambahan selain localhost/LAN dan CLOUDFLARE_TUNNEL_URL / PUBLIC_BASE_URL.
# Hanya berlaku bila API_ACCESS_TOKEN diisi (saat token kosong CORS masih longgar agar
# tidak diam-diam memutus alur yang sudah jalan). Pisahkan dengan koma.
# CORS_EXTRA_ORIGINS=https://nama-anda.trycloudflare.com,http://192.168.1.50:3000

# Batas kuota produksi video harian (default: 20 video per hari untuk menjaga IP dari pemblokiran)
DAILY_VIDEO_LIMIT=20

# ============================================================================
# AUDIO-DRIVEN SCENE PLANNING (Fase 1 & 2) - percobaan, DEFAULT MATI.
# Bila ON: wajibkan video punya voice-over, potong adegan mengikuti jeda
# narasi (whisper), lalu parafrase anti-plagiat via model teks -> Gemini TTS.
# Memerlukan binary whisper.cpp + model ggml di disk (lihat WHISPER_* di bawah).
# ============================================================================
AUDIO_DRIVEN_SCENES=false
# Binary whisper.cpp (whisper-cli/main) + model. Absolut atau relatif server/.
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODEL=models/ggml-base.bin
WHISPER_LANG=id
WHISPER_TIMEOUT_MS=600000
# Rentang durasi beat adegan (detik)
AUDIO_BEAT_MIN_SEC=1
AUDIO_BEAT_IDEAL_MAX_SEC=5
AUDIO_BEAT_MAX_SEC=7
# Ambang gerbang "wajib voice-over"
AUDIO_MIN_SPEECH_SEC=3
AUDIO_MIN_SPEECH_COVERAGE=0.15
AUDIO_MIN_SPEECH_WORDS=6
# Engine model teks anti-plagiat (kosong = ikut ACTIVE_AI_ENGINE). Model override opsional.
ANTIPLAGIAT_AI_ENGINE=
ANTIPLAGIAT_MODEL=
ANTIPLAGIAT_WORD_TOLERANCE=0.3

# ============================================================================
# VARIABEL LANJUTAN (opsional - default sudah benar; ubah hanya bila perlu)
# ============================================================================

# --- Autentikasi & fallback downloader (yt-dlp) ---
# GOOGLE_API_KEY=            # alias alternatif GEMINI_API_KEY (opsional).
# DISABLE_COOKIES=true       # atau NO_COOKIES=true: paksa TANPA cookies (default: pakai cookies bila ada).
# RESIDENTIAL_PROXY=         # atau PROXY_URL=: proxy yt-dlp (mis. http://user:pass@host:port). Default kosong.
# YTDLP_RATE_LIMIT=2M        # batasi laju unduh (--limit-rate). Default: tanpa batas.
# YTDLP_SLEEP_REQUESTS=1     # jeda detik antar request yt-dlp (--sleep-requests). Default: tanpa jeda.
# YOUTUBE_API_KEY=           # atau GOOGLE_YOUTUBE_API_KEY=: YouTube Data API resmi untuk pencarian (opsional; tanpa ini pakai scraping/DDG).

# --- Budget sampling frame & Gatekeeper ---
# GK_MAX_BATCH_FRAMES=240    # jumlah frame maksimum yang dibaca Gatekeeper per kandidat.
# GK_TIMEOUT_SEC_PER_FRAME=4 # jatah waktu pemanggil Node per frame (timeout lokal 127.0.0.1:5050).
#   Naikkan 6-8 di HP/Termux (Unisoc 2-core) bila log gatekeeper sering:
#   "Klien terputus sebelum hasil N frame terkirim" -> batch tidak lagi di-abort Node.
#   Total timeout = max(300, frame x nilai ini + 120) detik. Default 4 = perilaku lama (PC aman).
# SAMPLE_MAX_FRAMES=500      # plafon jumlah frame hasil sampling.
# RENDER_SAMPLE_INTERVAL_SEC=1.5 # jarak antar titik sampling dari stream (detik).
#   1.5 = desain awal (~40 titik/menit): video 5 menit = 200 frame, 10 menit = 400 frame.
#   Naikkan ke 3.0 untuk hemat kuota/FFmpeg (5 menit = 100 frame) bila perangkat lambat;
#   makin rapat = makin banyak jendela bersih & variasi klip, tapi beban CPU + I/O naik.
# SAMPLE_BATCH_MODE=1        # ekstraksi frame batch (DEFAULT ON). Set 0 untuk non-batch.
# GK_WATERMARK_PROBE=1       # probe watermark/promo saat sampling >20 titik (DEFAULT ON). Set 0 untuk mati.

# --- Quality Control akhir (sebelum publish) ---
# FINAL_AI_QC=1              # QC AI final pasca-render (DEFAULT ON). Set 'false' untuk mematikan.
# FINAL_AI_QC_STRICT=0       # DEFAULT OFF. Set 'true' untuk menolak job bila QC final tidak lolos.

# --- Backend wajah lokal (proses Gatekeeper Python, port 5050) ---
# GK_FACE_BACKEND=scrfd      # DEFAULT 'scrfd' (filter wajah lokal). Set 'yunet' untuk MediaPipe+YuNet.
# GK_SCRFD_INPUT=480         # resolusi input model SCRFD dalam piksel. Default 480.
# GK_TEXT_CHECK_STRIDE=3     # pemeriksaan teks/OCR tiap N frame. Default 3.


# -------------------------------------------------------------------
# WHISPER-FIRST PIPELINE SETTINGS
# -------------------------------------------------------------------
PIPELINE_MODE=whisper_first
QUICK_PREVIEW_DURATION_SEC=15
WHISPER_CONTEXT_DURATION_SEC=25
WHISPER_NARRATION_MIN_COVERAGE=0.30
BEST_WINDOW_DURATION_SEC=25
RENDER_DOWNLOAD_SECTIONS=1
RENDER_NO_FULL_DOWNLOAD=1

# -------------------------------------------------------------------
# BLUEPRINT ALUR BARU (6 langkah) - opt-in, default legacy (jalur lama)
# -------------------------------------------------------------------
# 'v2' = aktifkan runSourceAcquisitionV2: vonis batch Gemini atas 2 klip 15s @9:16
# (Gatekeeper pre-filter dulu), transkrip Whisper penuh (5-15 mnt), AI teks pilih
# window, unduh HANYA segmen 1080p, susunan adegan zigzag, tanpa klip terbuang.
# Kosong/nilai lain = 'legacy' (Fase 1-4 lama, tidak berubah).
ACQUISITION_FLOW=legacy

# -------------------------------------------------------------------
# ARSITEKTUR GEMINI-FIRST + SmolVLM2 (opt-in) - DEFAULT MATI (legacy).
# Bentuk alur sesuai percakapan:
#   Gemini stream/File API usulkan window scene -> download klip 2-5s (360p)
#   -> sampling 1 fps (2 dtk=2 frame, 5 dtk=5 frame) -> filter ringan
#   -> SmolVLM2-500M verifikasi per scene (PASS/REJECT) -> FFmpeg.
#   Gerbang Whisper DILEWATI pada mode ini; trio gatekeeper ONNX lama diganti.
# Semua dibekukan per-job (configSnapshot) sehingga retry memakai mode yang sama.
# -------------------------------------------------------------------
# VISION_VERIFY_MODE=legacy   # 'legacy' (default, gatekeeper ONNX + Whisper) | 'smolvlm' (alur baru) | 'oracle' (vonis model besar di Kaggle).
# GEMINI_SCENE_DISCOVERY=0     # 1 = Gemini stream/File API mencari kandidat scene window.
# SCENE_CLIP_DURATION_SEC=4    # panjang klip per kandidat (clamp 2-5); = jumlah frame saat 1 fps.
# SCENE_SAMPLE_FPS=1           # rasio frame per detik klip.
# GK_VLM_TIMEOUT_SEC_PER_FRAME=10  # jatah waktu VLM per frame (detik) utk timeout llama-mtmd-cli.
# --- Biner & bobot VLM (setelah build setup-vlm-termux.sh + scp model GGUF dari PC) ---
# GK_VLM_BIN=../bin/llama/llama-mtmd-cli
# GK_VLM_MODEL=gatekeeper/models/smolvlm2-500m.Q4_K_M.gguf
# GK_VLM_MMPROJ=gatekeeper/models/smolvlm2-500m-mmproj.gguf
# GK_VLM_MAX_FRAMES_PER_SCENE=5   # plafon frame per scene yang dikirim ke VLM.

# -------------------------------------------------------------------
# VLM ORACLE - VONIS MODEL BESAR DI KAGGLE (VISION_VERIFY_MODE=oracle)
# -------------------------------------------------------------------
# Kenapa: di Termux (Unisoc T7250) SmolVLM2 TERUKUR 36-52 DETIK PER FRAME dan sering
# salah vonis, sehingga tidak bisa dipakai sebagai gerbang per-scene. Di mode 'oracle'
# bobot Vision-Language (default Qwen2.5-VL-3B-Instruct fp16 - SATU bobot, rantai fallback
# antar-model sudah DIHAPUS dari notebook; override lewat ORACLE_MODEL_ID di sisi Kaggle)
# jalan di GPU Kaggle lewat notebook
# kaggle/vlm_oracle_qwen.py; HP/PC Anda hanya mengantre batch frame di SQLite dan
# menunggu vonis. Pipeline (unduh, Whisper, render, gatekeeper ONNX) TETAP lokal.
#
# ARAH PANGGILAN: notebook Kaggle yang menjadi KLIEN (tidak ada inbound ke Kaggle).
# Ia memanggil /api/vlm-oracle/claim -> unduh frame -> POST /api/vlm-oracle/result.
#
# KEBIJAKAN FALLBACK (PENTING - ini bukan fail-open):
#   oracle menjawab -> frame yang divonis KOTOR masuk blacklistedFramePaths.
#   oracle diam / timeout / vonis tidak sah / notebook mati -> TIDAK ADA frame diveto,
#   keputusan gatekeeper legacy + Gemini tetap berlaku penuh. Jalur legacy tidak pernah
#   dilewati (berbeda dengan mode 'smolvlm' yang me-return lebih awal).
#
# SYARAT WAJIB: API_ACCESS_TOKEN (di atas) HARUS terisi. Endpoint oracle sengaja
# menolak layanan (HTTP 503) selama token kosong, karena yang mengambil data adalah
# mesin di luar jaringan Anda dan yang diserahkan adalah bingkai video Anda.
# VLM_ORACLE_BASE_URL hanya untuk kenyamanan log/status; nilai yang dipakai notebook
# ada di Kaggle Secrets.
#
# VLM_ORACLE_MAX_FRAMES=120           # plafon TOTAL frame per job yang dikirim ke GPU (0 = tidak ada yang divisit)
# VLM_ORACLE_BATCH_SIZE=8             # frame per batch, dijepit 1-16
# VLM_ORACLE_FRAME_HEIGHT=360         # tinggi JPEG yang DIKIRIM ke notebook (240-720; 0 = mentah)
#   Download section + frame bank tetap 1080p apa adanya; hanya SALINAN yang diserahkan ke
#   Kaggle yang dikecilkan (FFmpeg scale=-2:360) di server/temp/oracle_frames/. Untung: byte
#   naik lewat tunnel turun drastis (terukur 298 KB -> 32 KB pada frame 1080p) dan
#   vision-token GPU turun. Trade-off: watermark kecil atau
#   subtitle tipis bisa jadi tidak terbaca model -> kalibrasi dulu (scratch/oracle_calibrate.mjs),
#   naikkan ke 480/720 kalau recall jatuh.
# VLM_ORACLE_AUDIT_MAX_FRAMES=90      # plafon frame pass KEDUA (audit klip final di clip_audit,
#   memakai frame 2,5 fps yang SUDAH diekstrak dari file 1080p terunduh; 0 = pass audit off)
# VLM_ORACLE_TIMEOUT_SEC=180          # tunggu maksimal per batch (floor 5s); lewat = lanjut legacy
# VLM_ORACLE_TOTAL_TIMEOUT_SEC=600    # anggaran waktu seluruh tahap oracle dalam satu job
# VLM_ORACLE_POLL_MS=2000             # interval worker memeriksa vonis
# VLM_ORACLE_STALE_SEC=300            # batch 'claimed' lebih tua dari ini dianggap notebook mati
# VLM_ORACLE_MAX_ATTEMPTS=2           # setelah ini batch ditandai 'expired' (GPU tidak dibuang)
# VLM_ORACLE_BASE_URL=https://nama-anda.trycloudflare.com
#
# SISI NOTEBOOK (bukan server ini - set di oracle_config.json / env Kaggle):
# ORACLE_MODEL_ID=qwen/Qwen2.5-VL-3B-Instruct   # default. Ganti ke bobot lain kalau mau,
#   tapi TIDAK ada lagi fallback diam-diam: bila bobot pilihan gagal dimuat, sesi notebook
#   berhenti dan tidak ada vonis (aman - gatekeeper lokal tetap bekerja sebagai gerbang).
#   ORACLE_FALLBACK_MODEL_ID tidak dipakai lagi; kalau masih tersisa di config, notebook
#   mencetak catatan bahwa nilainya diabaikan.
# ORACLE_REQUIRE_GPU=1      # default: sesi BERHENTI kalau CUDA tidak terlihat, bukan turun
#   ke CPU (belasan kali lebih lambat sambil tetap memotong kuota GPU mingguan - angka
#   kuota yang dipakai lihat README bagian "Kuota"). Set 0 hanya untuk debug; deploy.ps1
#   -AllowCpu menulis key ini.
# ORACLE_TORCH_DTYPE=float16 # default float16, BUKAN "auto". "auto" membaca config bobot =
#   bfloat16, dan T4 (Turing) tidak punya jalur cepat bf16. Nilai lain: auto|bfloat16|float32.
# ORACLE_MODEL_MOUNT=/kaggle/input/models/...  # paksa path bobot yang sudah ter-mount.
#   Biasanya tidak perlu: worker mengenali snapshot Qwen2.5-VL dari ISI direktorinya.
#   Ini yang memangkas biaya terukur 2026-10-03: tanpa mount siap pakai 86,7 s (22 s pip +
#   21 s unduh HF + 47 s muat), dengan mount 62,3 s (22 s pip + 22 s muat + 3,6 s processor).
#   Processor TETAP diambil dari HF id karena preprocessor_config.json mirror Kaggle ditolak
#   AutoProcessor (kernel v10 mati di situ) - hanya file kecil, bobotnya tidak diunduh.
# HF_TOKEN=                 # opsional, hanya mempercepat unduhan HF (rate limit/429 dari
#   jaringan Kaggle). Tidak wajib bila bobot sudah di-mount. deploy.ps1 mengambilnya dari
#   server/.env dan menyimpannya di dataset konfigurasi yang PRIVAT.
